Options -Indexes
RewriteEngine On

# Legacy portfolio URLs returned by the API use /uploads/.
RewriteRule ^uploads/(.*)$ api/uploads/$1 [L]

# Keep the API and built assets outside the SPA fallback.
RewriteRule ^api(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
